SEED_CSV_PATH=/app/data/data_dump.csv
BACKFILL_START_SEASON_ID=20222023
BACKFILL_THROUGH_SEASON_ID=20262027
GAME_TYPE_ID=2
DAILY_CORRECTION_LOOKBACK_DAYS=3
DAILY_MAX_RECOVERY_DAYS=14
DAILY_TIMEZONE=America/New_York
# Local Docker Compose uses this value inside the api container:
# DATABASE_URL=postgresql+psycopg://nhl:nhl@db:5432/nhl
# Managed PostgreSQL accepts provider URLs in either form:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
# GitHub Actions reads the equivalent value from the NHL_DATABASE_URL secret.
